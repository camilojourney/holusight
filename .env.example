# holusight v0.3 environment variables
# Copy to .env and fill in values (or set in your shell)

# ---------------------------------------------------------------------------
# LLM Backend (for ask() answer synthesis)
# ---------------------------------------------------------------------------

# Which LLM backend to use: claude, azure, openai, ollama
# Default: claude
HOLUSIGHT_LLM_BACKEND=claude

# Claude (default)
ANTHROPIC_API_KEY=sk-ant-...

# Azure OpenAI (data stays in client's Azure tenant)
# HOLUSIGHT_LLM_BACKEND=azure
# AZURE_OPENAI_ENDPOINT=https://mycompany.openai.azure.com/
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# OpenAI
# HOLUSIGHT_LLM_BACKEND=openai
# OPENAI_API_KEY=sk-...

# Ollama (100% local, zero network)
# HOLUSIGHT_LLM_BACKEND=ollama
# OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Embedding Model
# ---------------------------------------------------------------------------

# Local embedding model (sentence-transformers)
# Options: Qwen/Qwen3-Embedding-8B (default, 4096d — strongest open-weight
#              MTEB retrieval score as of writing, asymmetric query
#              prompting applied automatically, but noticeably slower per
#              embed — adds real latency to interactive query embedding;
#              fine for batch indexing on capable hardware),
#          Qwen/Qwen3-Embedding-4B (2560d, still strong, faster),
#          Qwen/Qwen3-Embedding-0.6B (1024d, fast enough to feel
#              instant on modest hardware, still well above MiniLM),
#          sentence-transformers/all-MiniLM-L6-v2 (384d, smallest/fastest,
#              the old default — a fine choice on constrained hardware),
#          nomic-ai/nomic-embed-text-v1.5 (768d),
#          mixedbread-ai/mxbai-embed-large-v1 (1024d),
#          jinaai/jina-embeddings-v2-base-code (768d, best for code)
HOLUSIGHT_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# Embedding backend: local (default) or api (OpenAI)
# API requires OPENAI_API_KEY
HOLUSIGHT_EMBEDDING_BACKEND=local

# ---------------------------------------------------------------------------
# Cross-Encoder Reranking (optional, improves precision)
# ---------------------------------------------------------------------------

# Enable reranking after RRF merge: true or false
# Default: false (zero overhead when disabled)
HOLUSIGHT_RERANKER=false

# Reranker model: cross-encoder/ms-marco-MiniLM-L-6-v2 (80MB, fast)
# Alternative: cross-encoder/ms-marco-MiniLM-L-12-v2 (better quality)
HOLUSIGHT_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# How many RRF results to feed to the reranker (default: 20)
HOLUSIGHT_RERANKER_TOP_N=20

# ---------------------------------------------------------------------------
# Storage & Indexing
# ---------------------------------------------------------------------------

# Directory where search indexes are stored
# Default: ~/.holusight/data
HOLUSIGHT_DATA_DIR=~/.holusight/data

# Staleness threshold in seconds (auto-refresh if older)
# Default: 300 (5 minutes)
HOLUSIGHT_STALE_SECONDS=300

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Production server (FastAPI / Docker)
# ---------------------------------------------------------------------------

# Required for production-shaped deployments (Docker sets HOLUSIGHT_PRODUCTION=1)
HOLUSIGHT_API_KEY=change-me-to-a-long-random-secret

# Document folder inside container or on host
HOLUSIGHT_DOCUMENTS_DIR=/data

# Never set in customer production — local dev escape hatch only
# HOLUSIGHT_ALLOW_UNAUTHENTICATED=true
