{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(pytest *)",
      "Bash(ruff check *)",
      "Bash(ruff format *)",
      "Bash(pip install *)",
      "Bash(python -m holusight *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "TaskCompleted": [
      {
        "type": "command",
        "command": "uv run --offline --extra dev pytest tests/ -q --tb=no",
        "description": "Run tests before marking task complete"
      }
    ]
  }
}
