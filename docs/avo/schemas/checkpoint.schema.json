{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "holusight-avo-checkpoint/v1",
  "title": "Holusight AVO Compact Lane Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "lane_id",
    "branch",
    "checkpoint_sequence",
    "created_at",
    "manifest_sha256",
    "last_experiment_id",
    "ledger_entry_count",
    "lineage_head",
    "evaluator_identity_digest",
    "counts",
    "ledger_tail_sha256",
    "publication"
  ],
  "properties": {
    "schema_version": { "const": "holusight-avo-checkpoint/v1" },
    "campaign_id": { "const": "holusight-avo-v1" },
    "lane_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "branch": {
      "type": "string",
      "pattern": "^fm/holusight-avo-[a-z0-9-]+$"
    },
    "checkpoint_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "last_experiment_id": {
      "type": "string",
      "pattern": "^[0-9]{4}$"
    },
    "ledger_entry_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of ledger entries covered by this checkpoint prefix."
    },
    "lineage_head": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "description": "Git commit SHA of current-best lineage on this lane branch."
    },
    "evaluator_identity_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed",
        "kept",
        "discarded",
        "crashed",
        "rejected",
        "indeterminate"
      ],
      "properties": {
        "completed": { "type": "integer", "minimum": 0 },
        "kept": { "type": "integer", "minimum": 0 },
        "discarded": { "type": "integer", "minimum": 0 },
        "crashed": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "indeterminate": { "type": "integer", "minimum": 0 }
      }
    },
    "ledger_tail_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 of canonical JSON for the last ledger entry (no trailing newline)."
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_commit", "git_tree", "path", "byte_length"],
      "properties": {
        "git_commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "git_tree": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "path": {
          "type": "string",
          "pattern": "^docs/avo/lanes/[a-z0-9-]+/checkpoints/[A-Za-z0-9._-]+$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "Immutable Git publication provenance for this checkpoint file."
    },
    "supervisor_state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "campaign_pause": { "type": "boolean" },
        "lane_close": { "type": "boolean" },
        "resume_generation": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "Optional supervisor pause/close/resume state; schema-valid when present."
    }
  }
}
