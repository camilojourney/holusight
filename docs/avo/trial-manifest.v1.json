    "branch_name_pattern": "^fm/holusight-avo-[a-z0-9-]+$",
    "max_checkpoint_bytes": 4096
  },
  "ledger_policy": {
    "schema": "holusight-avo-ledger/v1",
    "append_only": true,
    "record_outcomes": [
      "completed",
      "kept",
      "discarded",
      "rejected",
      "indeterminate",
      "crashed"
    ]
  },
  "protected_gates": [
