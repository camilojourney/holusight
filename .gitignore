tasks/

# graphify - commit graph.json; ignore generated outputs and local state
graphify-out/*.html
graphify-out/*.svg
graphify-out/*.graphml
graphify-out/.graphify_labels.json
graphify-out/.graphify_root
graphify-out/cache/
# Isolated source-only experiments are not the canonical whole-repo graph.
graphify-out/graph-counterfactual-*/
graphify-out/wiki/
graphify-out/GRAPH_REPORT.md
graphify-out/cypher.txt
graphify-out/manifest.json
!graphify-out/graph.json
.vercel
graphify-out/.vocab.txt
